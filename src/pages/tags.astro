---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getTagCloud, getTags } from '../lib/articles';
const articles = await getArticles();
const tags = getTags(articles);
const cloud = getTagCloud(articles);
const maxCount = Math.max(...cloud.map((tag) => tag.count));
---
<BaseLayout title="标签"><section class="container"><p class="eyebrow">Index</p><h1>标签</h1><p>主题入口用于浏览，词云从文章标题、分类与原始标签中统计，省去目录名和一次性词汇。</p><div class="tags">{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.name}<small>{tag.count}</small></a>)}</div><section class="cloud-section"><p class="eyebrow">Detailed signals</p><h2>细粒度标签词云</h2><p>字号反映文章数量；每个词都可进入对应文章列表。</p><div class="cloud">{cloud.map((tag) => <a href={`/tags/${tag.slug}/`} style={`font-size:${(.85 + tag.count / maxCount * .9).toFixed(2)}rem`} title={`${tag.name}：${tag.count} 篇文章`}>{tag.name}<small>{tag.count}</small></a>)}</div></section></section></BaseLayout>
<style>section{max-width:800px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}p{color:var(--muted)}.tags{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.tags a{border:1px solid var(--line);padding:.55rem .7rem;font-size:.88rem;background:var(--paper)}.tags a:hover{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}small{margin-left:.55rem;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem}.cloud-section{margin-top:5rem;padding-top:2rem;border-top:1px solid var(--line)}.cloud-section h2{margin:.25rem 0;font-size:clamp(1.7rem,3vw,2.35rem);letter-spacing:-.045em}.cloud-section>p:last-of-type{margin-top:.3rem;font-size:.9rem}.cloud{display:flex;flex-wrap:wrap;align-items:baseline;gap:.55rem .9rem;margin-top:1.8rem;padding:1.35rem;background:var(--wash);border:1px solid var(--line)}.cloud a{line-height:1.15;color:var(--ink);text-wrap:pretty}.cloud a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:.2em}.cloud small{vertical-align:middle;font-size:.58em}</style>
