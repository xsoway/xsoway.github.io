---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getTags } from '../lib/articles';
const articles = await getArticles();
const tags = getTags(articles);
---
<BaseLayout title="标签"><section class="container"><p class="eyebrow">Index</p><h1>标签</h1><p>标签来自文章的 <code>tags</code>，以及文章末尾的 <code>#标签</code>；<code>draft</code> 不会显示。</p><div class="tags">{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.name}<small>{tag.count}</small></a>)}</div></section></BaseLayout>
<style>section{max-width:880px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}p{color:var(--muted)}code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.86em}.tags{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.tags a{border:1px solid var(--line);padding:.55rem .7rem;font-size:.88rem;background:var(--paper)}.tags a:hover{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}small{margin-left:.55rem;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem}</style>
