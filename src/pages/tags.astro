---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getTags } from '../lib/articles';
const articles = await getArticles();
const tags = getTags(articles);
---
<BaseLayout title="标签"><section class="container"><p class="eyebrow">Index</p><h1>标签</h1><p>将文章标题、分类和原始标签归并为少量稳定主题，避免把系统名、目录名和一次性词汇变成无效入口。</p><div class="tags">{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.name}<small>{tag.count}</small></a>)}</div></section></BaseLayout>
<style>section{max-width:800px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}p{color:var(--muted)}.tags{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.tags a,.tags span{border:1px solid var(--line);padding:.55rem .7rem;font-size:.88rem;background:var(--paper)}.tags a:hover{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}.tags small{margin-left:.55rem;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem}</style>
