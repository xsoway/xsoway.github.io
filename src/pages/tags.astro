---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, topics, topicArticles } from '../lib/articles';
const articles = await getArticles();
const explicitTags = [...new Set(articles.flatMap((article) => article.data.tags ?? []))].sort();
---
<BaseLayout title="标签"><section class="container"><p class="eyebrow">Index</p><h1>标签</h1><p>目前文章的内容入口以专题为主。随着新文章写入标签，本站会在这里自动汇总。</p><div class="tags">{topics.map((topic) => <a href={`/topics/#${topic.slug}`}>{topic.name}<small>{topicArticles(articles, topic.slug).length}</small></a>)}{explicitTags.map((tag) => <span>{tag}</span>)}</div></section></BaseLayout>
<style>section{max-width:800px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}p{color:var(--muted)}.tags{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.tags a,.tags span{border:1px solid var(--line);padding:.55rem .7rem;font-size:.88rem;background:var(--paper)}.tags a:hover{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}.tags small{margin-left:.55rem;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem}</style>
