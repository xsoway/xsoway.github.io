---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getArticles, getTagCloud, getTags } from '../lib/articles';
const articles = await getArticles();
const tags = getTags(articles);
const cloud = getTagCloud(articles);
const maxCount = Math.max(...cloud.map((tag) => tag.count));
---
<BaseLayout title="标签"><section class="container"><p class="eyebrow">Index</p><h1>标签</h1><p>主题入口用于浏览；下方词云直接统计文章笔记属性中的 <code>tags</code>。</p><div class="tags">{tags.map((tag) => <a href={`/tags/${tag.slug}/`}>{tag.name}<small>{tag.count}</small></a>)}</div><section class="cloud-section"><p class="eyebrow">Raw article tags</p><h2>标签词云</h2><p>圆的大小代表使用次数，点击即可查看对应文章。</p><div class="cloud">{cloud.map((tag) => <a href={`/tags/${tag.slug}/`} style={`--size:${(3.25 + tag.count / maxCount * 2.75).toFixed(2)}rem`} title={`${tag.name}：${tag.count} 篇文章`}><span>{tag.name}</span><small>{tag.count}</small></a>)}</div></section></section></BaseLayout>
<style>section{max-width:880px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}p{color:var(--muted)}code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.86em}.tags{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}.tags a{border:1px solid var(--line);padding:.55rem .7rem;font-size:.88rem;background:var(--paper)}.tags a:hover{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}small{margin-left:.55rem;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem}.cloud-section{margin-top:5rem;padding-top:2rem;border-top:1px solid var(--line)}.cloud-section h2{margin:.25rem 0;font-size:clamp(1.7rem,3vw,2.35rem);letter-spacing:-.045em}.cloud-section>p:last-of-type{margin-top:.3rem;font-size:.9rem}.cloud{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:.7rem;padding:1.75rem;background:var(--wash);border:1px solid var(--line)}.cloud a{width:var(--size);height:var(--size);display:grid;place-content:center;text-align:center;gap:.1rem;padding:.35rem;border:1px solid color-mix(in srgb,var(--accent) 24%,var(--line));border-radius:50%;background:var(--paper);color:var(--ink);line-height:1.1;overflow:hidden;transition:transform .18s ease,border-color .18s ease,background .18s ease}.cloud a:hover,.cloud a:focus-visible{transform:translateY(-3px) scale(1.04);border-color:var(--accent);background:var(--accent-soft);color:var(--ink);text-decoration:none}.cloud span{max-width:100%;padding:0 .15rem;font-size:clamp(.65rem,1.6vw,.9rem);overflow-wrap:anywhere}.cloud small{margin:0;font-size:.6rem}@media (max-width:600px){.cloud{padding:1rem;gap:.5rem}.cloud a{--size:3.4rem!important}}</style>
