---
import { render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { articleDate, articleTitle, articleTopics, getArticles } from '../../lib/articles';
export async function getStaticPaths(){const articles=await getArticles();return articles.map(post=>({params:{slug:post.id},props:{post}}));}
const { post } = Astro.props; const { Content, headings } = await render(post); const articles = await getArticles(); const currentIndex = articles.findIndex((article) => article.id === post.id); const previous = articles[currentIndex + 1]; const next = articles[currentIndex - 1]; const postTopics = articleTopics(post); const related = articles.filter((article) => article.id !== post.id && articleTopics(article).some((topic) => postTopics.some((current) => current.slug === topic.slug))).slice(0, 3);
---
<BaseLayout title={articleTitle(post)}><div class="reading-progress" aria-hidden="true"><i></i></div><article class="container"><header><p class="eyebrow">{articleDate(post)}</p><h1>{articleTitle(post)}</h1><div class="post-topics">{postTopics.map((topic) => <a href={`/topics/#${topic.slug}`}>{topic.name}</a>)}</div></header><div class="article-layout"><div class="prose"><Content /><nav class="post-nav" aria-label="文章导航">{previous ? <a href={`/articles/${previous.id}/`}><span>← 较早文章</span>{articleTitle(previous)}</a> : <span />}{next ? <a href={`/articles/${next.id}/`} class="next"><span>较新文章 →</span>{articleTitle(next)}</a> : <span />}</nav></div>{headings.length > 1 && <aside class="toc"><span>本文目录</span><ol>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></aside>}</div></article>{related.length > 0 && <section class="container related"><p class="eyebrow">Continue reading</p><h2>继续阅读</h2><div>{related.map((article) => <ArticleCard {article} />)}</div></section></BaseLayout>
<script>const indicator = document.querySelector('.reading-progress i'); addEventListener('scroll',()=>{const height=document.documentElement.scrollHeight-innerHeight;indicator.style.width=`${height ? scrollY / height * 100 : 0}%`;},{passive:true});</script>
<style>.reading-progress{height:3px;position:fixed;inset:70px 0 auto;z-index:9;background:transparent}.reading-progress i{display:block;width:0;height:100%;background:var(--accent)}article{max-width:1160px;padding-top:5rem}article>header{max-width:800px;margin:0 auto 3.5rem}h1{font-size:clamp(2.4rem,5vw,4.5rem);line-height:1.16;letter-spacing:-.06em;margin:.55rem 0 1.15rem;text-wrap:pretty}.post-topics{display:flex;flex-wrap:wrap;gap:.5rem}.post-topics a{border:1px solid var(--line);padding:.23rem .5rem;color:var(--accent);font-size:.78rem}.article-layout{display:grid;grid-template-columns:minmax(0,760px) 190px;justify-content:center;gap:4rem}.toc{align-self:start;position:sticky;top:100px;border-left:1px solid var(--line);padding-left:1rem;font-size:.8rem}.toc>span{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);font-size:.7rem}.toc ol{margin:.65rem 0;padding-left:0;list-style:none}.toc li{margin:.45rem 0;line-height:1.45}.toc li.nested{padding-left:.7rem}.toc a{color:var(--muted)}.toc a:hover{color:var(--accent)}.post-nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:4rem;padding-top:1.5rem;border-top:1px solid var(--line)}.post-nav a{font-size:.88rem;text-decoration:none}.post-nav span{display:block;margin-bottom:.25rem;color:var(--muted);font-size:.72rem}.post-nav .next{text-align:right}.related{max-width:820px;margin-top:5rem}.related h2{margin:.3rem 0;font-size:2rem;letter-spacing:-.04em}.related>div{margin-top:1rem}@media (max-width:980px){.article-layout{display:block}.toc{display:none}}@media (max-width:600px){article{padding-top:3.5rem}.post-nav{grid-template-columns:1fr}.post-nav .next{text-align:left}.reading-progress{inset:70px 0 auto}}</style>
