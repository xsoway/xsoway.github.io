---
import { render } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import { articleDate, articleTitle, getArticles } from '../../lib/articles';
export async function getStaticPaths(){const articles=await getArticles();return articles.map(post=>({params:{slug:post.id},props:{post}}));}
const { post } = Astro.props; const { Content } = await render(post);
---
<BaseLayout title={articleTitle(post)}><article class="container"><header><p>{articleDate(post)} {post.data.category && `· ${post.data.category}`}</p><h1>{articleTitle(post)}</h1>{post.data.tags?.length ? <small>{post.data.tags.join(' · ')}</small> : null}</header><div class="prose"><Content /></div></article></BaseLayout><style>article{max-width:900px;padding-top:4rem}article>header{max-width:760px;margin:0 auto 3rem;border:0;position:static;background:none;backdrop-filter:none}p,small{color:var(--muted);font-size:.9rem}h1{font-size:clamp(2rem,4vw,3.3rem);line-height:1.25;letter-spacing:-.04em;margin:.45rem 0}</style>
