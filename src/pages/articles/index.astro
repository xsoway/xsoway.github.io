---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { getArticles } from '../../lib/articles';
const articles = await getArticles();
---
<BaseLayout title="文章"><section class="container"><p>ARCHIVE</p><h1>文章</h1><small>共 {articles.length} 篇公开文章</small>{articles.map(article => <ArticleCard {article} />)}</section></BaseLayout><style>section{max-width:820px;padding-top:4rem}p,small{color:var(--muted);font-size:.9rem}h1{font-size:2.4rem;margin:.2rem 0}</style>
