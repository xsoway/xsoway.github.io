---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { getArticles, topics } from '../../lib/articles';
const articles = await getArticles();
---
<BaseLayout title="文章"><section class="container"><p class="eyebrow">Writing archive</p><h1>文章</h1><p class="intro">共 {articles.length} 篇公开文章。可按专题筛选，或直接搜索标题与摘要。</p><div class="filters"><label><span class="sr-only">搜索文章</span><input id="article-search" type="search" placeholder="搜索文章…" /></label><div class="topic-filters"><button class="active" data-filter="">全部</button>{topics.map((topic) => <button data-filter={topic.slug}>{topic.name}</button>)}</div></div><p class="result-count" id="result-count">显示全部 {articles.length} 篇文章</p><div id="article-list">{articles.map(article => <ArticleCard {article} />)}</div><p class="no-results" hidden>没有找到匹配的文章，换个词试试。</p></section></BaseLayout>
<script>const search = document.querySelector('#article-search'); const cards = [...document.querySelectorAll('[data-article]')]; const buttons = [...document.querySelectorAll('[data-filter]')]; const result = document.querySelector('#result-count'); const empty = document.querySelector('.no-results'); let activeTopic = new URLSearchParams(location.search).get('topic') || ''; function apply(){const keyword = search.value.trim().toLowerCase();let visible=0;cards.forEach((card)=>{const matched = (!activeTopic || card.dataset.topics.includes(activeTopic)) && (!keyword || card.dataset.search.includes(keyword));card.hidden=!matched;if(matched) visible++;});result.textContent=`显示 ${visible} 篇文章`;empty.hidden=visible!==0;} search?.addEventListener('input',apply);buttons.forEach((button)=>button.addEventListener('click',()=>{activeTopic=button.dataset.filter;buttons.forEach((item)=>item.classList.toggle('active',item===button));apply();}));buttons.forEach((button)=>button.classList.toggle('active',button.dataset.filter===activeTopic));apply();</script>
<style>section{max-width:880px;padding-top:4.5rem}h1{font-size:clamp(2.6rem,5vw,4rem);letter-spacing:-.055em;margin:.3rem 0}.intro{color:var(--muted);margin:0}.filters{margin:2.2rem 0 1rem;padding:1rem;background:var(--wash);border:1px solid var(--line)}input{width:100%;border:1px solid var(--line);background:var(--paper);padding:.7rem .8rem;font:inherit;font-size:.9rem;outline-color:var(--accent)}.topic-filters{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.75rem}button{border:1px solid var(--line);background:transparent;padding:.32rem .55rem;color:var(--muted);font:inherit;font-size:.77rem;cursor:pointer}button.active,button:hover{border-color:var(--accent);background:var(--accent);color:white}.result-count{color:var(--muted);font-size:.8rem}.no-results{padding:2rem 0;color:var(--muted)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}</style>
