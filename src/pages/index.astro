---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, topics, topicArticles } from '../lib/articles';
const articles = await getArticles();
const featured = articles.slice(0, 3);
const latest = articles.slice(3, 11);
const datedArticles = articles.filter((article) => article.data.created);
const years = new Set(datedArticles.map((article) => article.data.created!.getFullYear())).size;
---
<BaseLayout>
  <section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Personal notes / since 2014</p><h1>把 AI 的能力，<em>做成真实可用的工具。</em></h1><p class="hero-copy">记录 Agent、Skills、测试工程、知识工具，以及技术与生活中的真实发现。</p><div class="hero-actions"><a class="button primary" href="/articles/">开始阅读</a><a class="button quiet" href="/about/">认识 Alan</a></div></div><aside class="hero-note"><span>01 / X·myLog</span><blockquote>离开乏味的皮囊，<br />自由的灵魂在路上。</blockquote><p>技术不是目的。它应该给生活留下更多空间。</p></aside></div></section>
  <section class="container stats" aria-label="网站数据"><div><strong>{articles.length}</strong><span>篇公开文章</span></div><div><strong>{topics.length}</strong><span>个内容专题</span></div><div><strong>{years}</strong><span>年持续记录</span></div><a href="/archives/">浏览全部归档 <span>→</span></a></section>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">Explore by theme</p><h2>从一个问题，走进一组文章</h2></div><a href="/topics/">全部专题 →</a></div><div class="topic-grid">{topics.map((topic, index) => <a class="topic-card" href={`/topics/#${topic.slug}`}><span>0{index + 1}</span><h3>{topic.name}</h3><p>{topic.description}</p><small>{topicArticles(articles, topic.slug).length} 篇文章 →</small></a>)}</div></section>
  <section class="container section"><div class="section-heading"><div><p class="eyebrow">Selected writing</p><h2>最近值得一读</h2></div><a href="/articles/">文章列表 →</a></div><div class="feature-grid">{featured.map((article) => <ArticleCard {article} />)}</div></section>
  <section class="container section latest"><div class="section-heading"><div><p class="eyebrow">Latest notes</p><h2>最新发布</h2></div><a href="/rss.xml">订阅 RSS →</a></div>{latest.map((article) => <ArticleCard {article} />)}</section>
</BaseLayout>
<style>.hero{padding:clamp(4.5rem,10vw,8.5rem) 0 4rem;background:linear-gradient(120deg,var(--paper) 40%,var(--accent-soft))}.hero-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(240px,.58fr);gap:clamp(2rem,8vw,8rem);align-items:end}.hero h1{max-width:760px;margin:.65rem 0 1.3rem;font-size:clamp(2.65rem,5.5vw,4.9rem);line-height:1.05;letter-spacing:-.065em;text-wrap:pretty}.hero h1 em{font-family:ui-serif,Georgia,"Songti SC",serif;font-weight:500}.hero-copy{max-width:560px;color:var(--muted);font-size:1.08rem}.hero-actions{display:flex;gap:.8rem;margin-top:1.8rem}.button{padding:.68rem 1.05rem;border:1px solid var(--ink);font-size:.88rem;font-weight:700}.primary{background:var(--ink);color:var(--paper)}.primary:hover{background:var(--accent);border-color:var(--accent);color:white}.quiet{border-color:var(--line);color:var(--muted)}.hero-note{border-left:1px solid var(--accent);padding-left:1.25rem;color:var(--muted)}.hero-note span{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.7rem;color:var(--accent)}.hero-note blockquote{margin:1.5rem 0 1rem;font-family:ui-serif,Georgia,"Songti SC",serif;font-size:1.4rem;line-height:1.5;color:var(--ink)}.hero-note p{font-size:.85rem}.stats{display:grid;grid-template-columns:repeat(3,1fr) auto;gap:1px;background:var(--line);border:1px solid var(--line)}.stats>div,.stats>a{background:var(--paper);padding:1.25rem 1.5rem}.stats strong{display:block;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:1.5rem}.stats span{font-size:.78rem;color:var(--muted)}.stats>a{display:grid;place-content:center;font-size:.84rem;color:var(--accent);font-weight:700}.section{margin-top:6.2rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.6rem}.section-heading h2{margin:.35rem 0 0;font-size:clamp(1.7rem,3vw,2.45rem);letter-spacing:-.045em}.section-heading>a{font-size:.85rem;color:var(--accent);white-space:nowrap}.topic-grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}.topic-card{min-height:215px;padding:1.2rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--paper);transition:background .18s ease,transform .18s ease}.topic-card:hover{background:var(--accent-soft);color:var(--ink);transform:translateY(-3px)}.topic-card>span{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--accent);font-size:.72rem}.topic-card h3{margin:2.7rem 0 .35rem;font-size:1.05rem;line-height:1.4}.topic-card p{margin:0;color:var(--muted);font-size:.8rem;line-height:1.6}.topic-card small{display:block;margin-top:1.5rem;color:var(--accent);font-size:.72rem}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem}.feature-grid :global(.article-card){border:1px solid var(--line);padding:1.35rem;background:var(--paper);box-shadow:0 5px 16px rgb(24 33 43 / .035)}.feature-grid :global(.article-card:hover){padding-left:1.65rem;box-shadow:var(--shadow)}.latest{max-width:840px}.latest .section-heading{margin-bottom:0}@media (max-width:850px){.topic-grid{grid-template-columns:repeat(3,1fr)}.feature-grid{grid-template-columns:1fr}.hero-grid{grid-template-columns:1fr}.hero-note{max-width:400px}}@media (max-width:600px){.hero{padding-top:4rem}.stats{grid-template-columns:1fr 1fr}.stats>a{grid-column:1/-1;padding:.9rem 1.5rem;display:block}.topic-grid{grid-template-columns:1fr 1fr}.section{margin-top:4.3rem}.topic-card{min-height:190px}.topic-card h3{margin-top:2rem}}</style>
