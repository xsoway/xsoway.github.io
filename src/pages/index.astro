---
import BaseLayout from '../layouts/BaseLayout.astro'; import ArticleCard from '../components/ArticleCard.astro'; import { getArticles } from '../lib/articles';
const articles = await getArticles();
---
<BaseLayout><section class="hero container"><p>AI · 测试工程 · 知识工具</p><h1>把 AI 的能力，做成可落地、可验证、可复用的工程工具。</h1><div>记录 Agent、Skills、质量工程，以及技术与生活中的真实发现。</div><a class="button" href="/articles/">阅读文章</a></section><section class="latest container"><h2>最新文章</h2>{articles.length ? articles.slice(0,8).map(article => <ArticleCard {article} />) : <p class="empty">暂无公开文章。为文章添加 <code>published: true</code> 后运行同步命令即可发布。</p>}</section></BaseLayout>
<style>.hero{padding:clamp(4rem,12vw,9rem) 0 5rem;max-width:900px}.hero>p{color:var(--accent);font-weight:700}.hero h1{font-size:clamp(2.2rem,5vw,4.4rem);line-height:1.16;letter-spacing:-.055em;margin:.5rem 0 1.25rem}.hero>div,.empty{color:var(--muted);font-size:1.08rem}.button{display:inline-block;margin-top:1.5rem;padding:.6rem 1rem;background:var(--ink);color:var(--paper);border-radius:7px}.latest{max-width:820px}.latest>h2{border-bottom:2px solid var(--ink);padding-bottom:.55rem}</style>
