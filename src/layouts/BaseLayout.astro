---
interface Props { title?: string; description?: string; }
const { title = 'Alan Hsu', description = 'AI、测试工程与知识工具的实践笔记。' } = Astro.props;
const navItems = [['文章', '/articles/'], ['归档', '/archives/'], ['专题', '/topics/'], ['标签', '/tags/'], ['关于', '/about/']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="alternate" type="application/rss+xml" title="Alan Hsu RSS" href="/rss.xml" /><title>{title === 'Alan Hsu' ? 'X·myLog · Alan Hsu' : `${title} · X·myLog`}</title></head><body><header class="site-header"><nav class="container"><a class="brand" href="/"><span>X·myLog</span><small>Alan Hsu</small></a><div class="desktop-nav">{navItems.map(([label, href]) => <a href={href}>{label}</a>)}</div><div class="site-links"><a class="rss" href="/rss.xml" aria-label="RSS">RSS</a><a href="https://github.com/xsoway" aria-label="GitHub">GitHub</a></div><details class="mobile-nav"><summary aria-label="打开菜单">菜单</summary><div>{navItems.map(([label, href]) => <a href={href}>{label}</a>)}<a href="https://github.com/xsoway">GitHub</a></div></details></nav></header><main><slot /></main><footer><div class="container footer-inner"><div><strong>X·myLog</strong><p>离开乏味的皮囊，自由的灵魂在路上。</p></div><div><a href="/about/">关于</a><a href="/rss.xml">RSS</a><a href="https://github.com/xsoway">GitHub</a></div><small>© {new Date().getFullYear()} Alan Hsu</small><small class="site-visits">总访问量 <strong id="site-visit-count">—</strong></small></div></footer><script is:inline>const endpoint='https://wlniezf5.api.lncldglobal.com/1.1/classes/Counter';const headers={'Content-Type':'application/json','X-LC-Id':'NeJmo3frExjRHKYlJDQZdbOP-MdYXbMMI','X-LC-Key':'bLdCeTqEJeJZYi8B9bw4T3hx'};async function count(url,title,outputId){const output=document.getElementById(outputId);try{const query=encodeURIComponent(JSON.stringify({url}));const response=await fetch(`${endpoint}?where=${query}`);const {results}=await response.json();if(results.length){const counter=results[0];if(output)output.textContent=String(counter.time+1);await fetch(`${endpoint}/${counter.objectId}`,{method:'PUT',headers,body:JSON.stringify({time:{__op:'Increment',amount:1}})});}else{const response=await fetch(endpoint,{method:'POST',headers,body:JSON.stringify({url,title,time:1})});if(!response.ok)throw new Error('counter initialization failed');if(output)output.textContent='1';}}catch(error){console.error('Visit counter error',error);}}count('__site_total__','网站总访问量','site-visit-count');if(document.getElementById('article-visit-count'))count(location.pathname,document.title,'article-visit-count');</script></body></html>
<style is:global>
:root{--ink:#18212b;--muted:#627080;--line:#dfe5e8;--paper:#fdfcf9;--wash:#f2f5f3;--deep:#10232a;--accent:#007f7a;--accent-soft:#ddf1ec;--warm:#e8d9c8;--shadow:0 18px 50px rgb(24 33 43 / .08)}*{box-sizing:border-box}html{scroll-behavior:smooth}body,body *{font-family:"Comic Sans MS","Comic Sans","PingFang SC","Microsoft YaHei",cursive!important}body{margin:0;background:var(--paper);color:var(--ink);line-height:1.75}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}.container{width:min(1160px,calc(100% - 40px));margin-inline:auto}.site-header{position:sticky;top:0;z-index:10;border-bottom:1px solid color-mix(in srgb,var(--line) 82%,transparent);background:color-mix(in srgb,var(--paper) 90%,transparent);backdrop-filter:blur(16px)}nav{min-height:70px;display:flex;align-items:center;gap:2rem}.brand{display:grid;line-height:1.05;margin-right:auto}.brand span{font-size:1.16rem;font-weight:800;letter-spacing:-.045em}.brand small{color:var(--accent);font-size:.63rem;letter-spacing:.11em;text-transform:uppercase;margin-top:.3rem}.desktop-nav,.site-links{display:flex;align-items:center;gap:1.35rem;font-size:.9rem;color:var(--muted)}.site-links{gap:.9rem;font-size:.76rem}.rss{color:var(--accent)}.mobile-nav{display:none;position:relative;font-size:.85rem;color:var(--muted)}.mobile-nav summary{cursor:pointer;list-style:none}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav div{position:absolute;right:0;top:2.1rem;width:10rem;padding:.65rem;background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow)}.mobile-nav a{display:block;padding:.45rem}footer{margin-top:6rem;border-top:1px solid var(--line);background:var(--wash)}.footer-inner{padding:2.5rem 0;display:grid;grid-template-columns:1fr auto;gap:1rem;color:var(--muted);font-size:.88rem}.footer-inner strong{color:var(--ink);letter-spacing:-.025em}.footer-inner p{margin:.25rem 0}.footer-inner div:nth-child(2){display:flex;gap:1rem;align-items:start}.footer-inner small{grid-column:1 / -1;color:#85909b}.footer-inner .site-visits strong{color:var(--accent)}.eyebrow{color:var(--accent);font-size:.75rem;letter-spacing:.11em;text-transform:uppercase}.prose{max-width:760px;margin-inline:auto;font-size:1.05rem}.prose h2{margin-top:3rem;line-height:1.3}.prose h3{margin-top:2.2rem;line-height:1.35}.prose a{color:var(--accent);text-decoration:underline;text-decoration-color:color-mix(in srgb,var(--accent) 35%,transparent);text-underline-offset:.18em}.prose img{max-width:100%;height:auto;border-radius:12px}.prose pre{overflow-x:auto;padding:1rem;border-radius:12px;background:var(--deep)}.prose table{width:100%;border-collapse:collapse;display:block;overflow-x:auto}.prose th,.prose td{border:1px solid var(--line);padding:.5rem .7rem;text-align:left}.prose blockquote{border-left:3px solid var(--accent);margin-left:0;padding-left:1rem;color:var(--muted)}@media (max-width:760px){.container{width:min(100% - 32px,1160px)}.desktop-nav,.site-links{display:none}.mobile-nav{display:block}.footer-inner{grid-template-columns:1fr}.footer-inner div:nth-child(2){grid-row:2}.prose{font-size:1rem}}
</style>
