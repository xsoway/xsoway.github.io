---
interface Props { title?: string; description?: string; }
const { title = 'Alan Hsu', description = 'AI、测试工程与知识工具的实践笔记。' } = Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="alternate" type="application/rss+xml" title="Alan Hsu RSS" href="/rss.xml" /><title>{title === 'Alan Hsu' ? title : `${title} · Alan Hsu`}</title></head><body><header><nav class="container"><a class="brand" href="/">Alan Hsu<span>.</span></a><div><a href="/articles/">文章</a><a href="/about/">关于</a><a href="https://github.com/xsoway">GitHub</a></div></nav></header><main><slot /></main><footer class="container">© {new Date().getFullYear()} Alan Hsu <a href="/rss.xml">RSS</a></footer></body></html>
<style is:global>
:root{color-scheme:light dark;--ink:#202124;--muted:#667085;--line:#e6e8ec;--paper:#fff;--wash:#f7f8fa;--accent:#1967d2}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:ui-sans-serif,-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.7}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}.container{width:min(1120px,calc(100% - 40px));margin-inline:auto}header{border-bottom:1px solid var(--line);position:sticky;top:0;background:color-mix(in srgb,var(--paper) 94%,transparent);backdrop-filter:blur(12px);z-index:2}nav{min-height:66px;display:flex;align-items:center;justify-content:space-between}nav div{display:flex;gap:1.25rem;color:var(--muted);font-size:.94rem}.brand{font-size:1.1rem;font-weight:750}.brand span{color:var(--accent)}footer{margin-top:5rem;padding-block:2rem;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--muted);font-size:.9rem}.prose{max-width:760px;margin-inline:auto;font-size:1.04rem}.prose h2{margin-top:2.8rem}.prose h3{margin-top:2rem}.prose img{max-width:100%;height:auto;border-radius:10px}.prose pre{overflow-x:auto;padding:1rem;border-radius:10px}.prose table{width:100%;border-collapse:collapse;display:block;overflow-x:auto}.prose th,.prose td{border:1px solid var(--line);padding:.5rem .7rem;text-align:left}.prose blockquote{border-left:3px solid var(--accent);margin-left:0;padding-left:1rem;color:var(--muted)}@media(prefers-color-scheme:dark){:root{--ink:#e8eaed;--muted:#aeb4bf;--line:#343942;--paper:#17191d;--wash:#20242a;--accent:#8ab4f8}}
</style>
